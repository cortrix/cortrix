# ==========================================================
# Cortrix — Environment Variable Template
#
# Copy to .env and fill in your values:
#   cp deploy/.env.example deploy/.env && nano deploy/.env
#
# Usage:
#   docker run --env-file deploy/.env -v ./data:/data cortrix:latest
# ==========================================================

# ===== Core =====
CORTRIX_DATA_DIR=/data
CORTRIX_HTTP_PORT=8420
CORTRIX_LOG_LEVEL=info

# ===== LLM =====
CORTRIX_LLM_PROVIDER=openai
CORTRIX_LLM_API_KEY=sk-proj-REPLACE-ME
CORTRIX_LLM_MODEL=gpt-4o-mini
CORTRIX_LLM_BASE_URL=https://api.openai.com/v1

# ===== Embedding =====
CORTRIX_EMBEDDING_MODEL=bge-m3-onnx
CORTRIX_EMBEDDING_DEVICE=cpu

# ===== SPC Pipeline =====
CORTRIX_SPC_WORKERS=2
CORTRIX_SPC_QUEUE_SIZE=100

# ===== AI Interaction Memory =====
CORTRIX_ENABLE_MEMORY=true

# ===== Web UI =====
CORTRIX_WEB_UI_ENABLED=true
CORTRIX_WEB_UI_PATH=/ui

# ===== Cortrix Agent =====
CORTRIX_AGENT_ENABLED=true
CORTRIX_AGENT_PORT=8000
