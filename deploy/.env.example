# ==========================================================
# Cortrix — Environment Variable Template
#
# Copy to .env and fill in your values:
#   cp deploy/.env.example deploy/.env && nano deploy/.env
#
# Usage:
#   docker run --env-file deploy/.env -v ./data:/data cortrix:latest
# ==========================================================

# ===== Core =====
CORTRIX_DATA_DIR=/data
CORTRIX_HTTP_PORT=8420
CORTRIX_LOG_LEVEL=info

# ===== LLM =====
CORTRIX_LLM_PROVIDER=openai
CORTRIX_LLM_API_KEY=sk-proj-REPLACE-ME
CORTRIX_LLM_MODEL=gpt-4o-mini
CORTRIX_LLM_BASE_URL=https://api.openai.com/v1

# ===== Model profile =====
# full provisions the required embedding assets and fails startup if they are
# unavailable. lite explicitly disables the embedding model and parser stack.
CORTRIX_PROFILE=full

# ===== ONNX execution providers =====
# auto uses CUDA first in the CUDA image and CPU in the default image.
# Set cuda only when startup must fail instead of falling back to CPU.
CORTRIX_EMBEDDING_EXECUTION_PROVIDER=auto
CORTRIX_RERANKER_EXECUTION_PROVIDER=auto

# Deprecated compatibility aliases (do not set with the canonical variables):
# CORTRIX_EMBEDDING_DEVICE=cpu
# CORTRIX_RERANKER_USE_COREML=false

# CUDA image only. Use a GPU index or UUID instead of all to restrict visibility.
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ===== SPC Pipeline =====
CORTRIX_SPC_WORKERS=2
CORTRIX_SPC_QUEUE_SIZE=100

# ===== AI Interaction Memory =====
CORTRIX_ENABLE_MEMORY=true

# ===== Web UI =====
CORTRIX_WEB_UI_ENABLED=true
CORTRIX_WEB_UI_PATH=/ui

# ===== Cortrix Agent =====
CORTRIX_AGENT_ENABLED=true
CORTRIX_AGENT_PORT=8000
