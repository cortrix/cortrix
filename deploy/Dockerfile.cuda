# ==========================================================
# Cortrix CUDA image — Linux x86_64 only
#
# Build from the repository root:
#   docker build --platform linux/amd64 -t cortrix:cuda \
#     -f deploy/Dockerfile.cuda .
#
# The official ONNX Runtime 1.17.1 GPU archive is linked against CUDA 11.x and
# cuDNN 8.x. The runtime
# base image also provides NVIDIA_REQUIRE_CUDA for host-driver compatibility
# enforcement by NVIDIA Container Toolkit.
# ==========================================================

# ========== Stage 1: C++ Builder ==========
FROM ubuntu:22.04@sha256:0d779ea97881505f5ef0039336ee85edba27519bdba968c284c86ee066a973c8 AS builder

ARG DEBIAN_FRONTEND=noninteractive

RUN test "$(uname -m)" = "x86_64"

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    curl \
    pkg-config \
    libssl-dev \
    libsqlite3-dev \
    libpq-dev \
    python3.10 \
    python3.10-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

ARG CMAKE_VERSION=4.4.0
ARG CMAKE_WHEEL_SHA256=51bcb2e65c0d5c1af4a749ba40a321b7436420c7359724ab46719004f3cd2149
RUN printf '%s\n' \
        "cmake==${CMAKE_VERSION} --hash=sha256:${CMAKE_WHEEL_SHA256}" \
        > /tmp/cmake-requirements.txt && \
    pip3 install --no-cache-dir --require-hashes -r /tmp/cmake-requirements.txt && \
    rm -f /tmp/cmake-requirements.txt

WORKDIR /build

COPY cmake          cortrix/cmake/
COPY CMakeLists.txt cortrix/CMakeLists.txt
COPY VERSION        cortrix/VERSION
COPY include        cortrix/include/
COPY src            cortrix/src/
COPY tests          cortrix/tests/

# CMake selects the official ONNX Runtime 1.17.1 Linux x86_64 GPU asset and
# verifies its repository-locked SHA-256 before extraction.
RUN mkdir -p build && cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DBUILD_TESTS=OFF \
          -DCORTRIX_ONNX_RUNTIME_FLAVOR=cuda \
          ../cortrix && \
    make -j$(nproc) cortrix-server && \
    strip cortrix-server

ARG PIP_INDEX_URL=https://pypi.org/simple
ENV PIP_INDEX_URL=${PIP_INDEX_URL} \
    PIP_TIMEOUT=120 \
    PIP_RETRIES=5

COPY cortrix-agent  cortrix/cortrix-agent/
COPY sdk/python     cortrix/sdk/python/
RUN mkdir -p /wheels && \
    pip3 wheel --no-cache-dir --wheel-dir /wheels \
        -r cortrix/cortrix-agent/requirements.txt

# ========== Stage 2: Web UI Builder ==========
FROM node:20-slim@sha256:3d0f05455dea2c82e2f76e7e2543964c30f6b7d673fc1a83286736d44fe4c41c AS web-builder

ARG NPM_REGISTRY=https://registry.npmjs.org

WORKDIR /build

COPY web/ ./web-ui/

RUN if [ -f "web-ui/package.json" ]; then \
        cd web-ui && \
        npm config set registry ${NPM_REGISTRY} && \
        npm ci --ignore-scripts --fetch-retries 5 --fetch-retry-maxtimeout 120000 && \
        npm run build && \
        rm -rf dist && mv static dist; \
    else \
        mkdir -p web-ui/dist && \
        echo '<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8">' \
             '<meta name="viewport" content="width=device-width,initial-scale=1.0">' \
             '<title>Cortrix</title>' \
             '<style>body{font-family:system-ui;display:flex;justify-content:center;' \
             'align-items:center;min-height:100vh;margin:0;background:#0a0a0a;color:#e0e0e0}' \
             '.c{text-align:center}h1{font-size:2.5rem;margin-bottom:.5rem}' \
             'p{color:#888;font-size:1.1rem}a{color:#6cb4ee}</style></head>' \
             '<body><div class="c"><h1>Cortrix</h1>' \
             '<p>Semantic Storage for the Agentic Era</p>' \
             '<p style="margin-top:2rem"><a href="/api/v1/health">/api/v1/health</a>' \
             ' &middot; <a href="/api/v1/namespaces">/api/v1/namespaces</a></p>' \
             '</div></body></html>' > web-ui/dist/index.html; \
    fi

COPY api/ ./api/
RUN npx --yes @redocly/cli@1.34.17 bundle api/openapi.yaml -o openapi.bundled.yaml --ext yaml

# ========== Stage 3: CUDA Runtime ==========
FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04@sha256:f6913f3c02f297877f6859d12ff330043c0be668fdad86868c29a239a5a82151

ARG DEBIAN_FRONTEND=noninteractive

LABEL maintainer="Cortrix Team <team@cortrix.ai>"
LABEL description="Cortrix CUDA — Semantic Storage for the Agentic Era"
LABEL version="1.0.0-rc.2"

ENV CORTRIX_ONNX_RUNTIME_FLAVOR=cuda \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libsqlite3-0 \
    libpq5 \
    python3.10 \
    python3-pip \
    python3.10-venv \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    supervisor \
    curl \
    wget \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash cortrix

RUN mkdir -p /app /app/config /app/web-ui /app/python /data /data/blobs /data/p-hnsw /data/logs && \
    chown -R cortrix:cortrix /app /data

WORKDIR /app

# Apache-2.0 redistribution materials for the runtime image.
COPY LICENSE NOTICE.md /app/

# The GPU distribution requires the provider shared objects in addition to the
# core ONNX Runtime library. entrypoint.sh checks this provider with ldd.
COPY --from=builder /build/build/cortrix-server /app/cortrix_server
COPY --from=builder /build/build/_deps/onnxruntime-src/lib/libonnxruntime*.so* /usr/local/lib/
RUN ldconfig

COPY deploy/cortrix.yaml               /app/config/cortrix.yaml
COPY src/logging/sensitive_fields.yaml /app/config/sensitive_fields.yaml

COPY --from=web-builder /build/web-ui/dist /app/web-ui
COPY --from=web-builder /build/openapi.bundled.yaml /app/build/openapi.bundled.yaml

COPY --from=builder /build/cortrix/cortrix-agent /app/python/cortrix-agent
COPY --from=builder /build/cortrix/sdk/python    /app/python/sdk/python
COPY --from=builder /wheels /tmp/wheels

COPY scripts/docling_bridge.py \
     scripts/paddleocr_bridge.py \
     scripts/requirements-parser.txt /app/scripts/

COPY deploy/download-models.sh /app/scripts/download-models.sh
RUN chmod +x /app/scripts/download-models.sh

RUN pip3 install --no-cache-dir /tmp/wheels/*.whl && rm -rf /tmp/wheels

COPY deploy/supervisord.conf /etc/supervisor/conf.d/cortrix.conf
COPY deploy/entrypoint.sh    /app/entrypoint.sh
COPY deploy/healthcheck.sh   /app/healthcheck.sh

RUN chmod +x /app/entrypoint.sh /app/healthcheck.sh && \
    chown -R cortrix:cortrix /app

USER cortrix
EXPOSE 8420
VOLUME ["/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD /app/healthcheck.sh

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["start"]
