# F23 lint config — matches the prevailing in-tree style (Google base,
# 4-space indent, 100 cols). CI enforcement is diff-only and currently a
# SOFT gate; full-tree reformat is a pending decision (would churn blame
# across 45+ frozen features).
BasedOnStyle: Google
IndentWidth: 4
AccessModifierOffset: -4
ColumnLimit: 100
DerivePointerAlignment: false
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: Inline
IncludeBlocks: Preserve
SortIncludes: false
