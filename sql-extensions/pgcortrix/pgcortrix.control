# pgcortrix — Cortrix semantic retrieval / memory as a PostgreSQL extension.
#
# F14 V1 route (F14-pgcortrix.md §1, L0' 2026-05-07): a plpython3u wrapper layer
# over the Cortrix Server HTTP REST API — NOT a C extension + shared-memory IPC
# (that is the V3+ roadmap). plpython3u keeps us PG-version-agnostic (13–17) and
# lets a function body change ship without recompiling / restarting PG.
#
# Built independently with PGXS (see Makefile); deliberately NOT part of the main
# cortrix/ CMake build (L1-α briefing §6, Lead ruling 2026-05-30).
comment = 'Cortrix semantic retrieval, document upload and memory query in SQL (plpython3u + HTTP)'
default_version = '1.0'
# Loads sql/pgcortrix--1.0.sql. plpython3u is an untrusted PL, so the extension
# is superuser-only to install — consistent with the SUSET endpoint GUC (§2.2).
superuser = true
relocatable = false
# plpython3u must exist first; CREATE EXTENSION pgcortrix pulls it in.
requires = 'plpython3u'
module_pathname = '$libdir/pgcortrix'
