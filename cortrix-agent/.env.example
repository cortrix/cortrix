# =============================================================================
# Cortrix Agent configuration template
#
# Usage:
#   cp cortrix-agent/.env.example cortrix-agent/.env
#   edit cortrix-agent/.env and fill in your LLM API key
#
# Note: cortrix-agent/.env is not committed to git
#       never commit a real API key to version control
# =============================================================================

# -----------------------------------------------------------------------------
# Cortrix backend connection
# -----------------------------------------------------------------------------
CORTRIX_BASE_URL=http://localhost:8420
CORTRIX_API_KEY=                        # fill in the API key when auth.enabled=true
CORTRIX_NAMESPACE=default               # default namespace to use

# -----------------------------------------------------------------------------
# LLM provider selection
# Pick one, uncomment it, and fill in the matching API key
#
# Options: glm / claude / openai / ollama / mock
#   (deepseek adapter ships in the V1.5 round; the catalog already lists it)
#   mock = retrieval-only mode, no LLM calls, no API key needed (for debugging)
#
# Note: settings here OVERRIDE the agent_llm section of build/config.yaml.
#   Resolution order (highest priority first, see config.py): real environment
#   variables > this .env file > build/config.yaml agent_llm > built-in defaults.
#   So if you already set the agent_llm block in config.yaml you don't need to
#   repeat it here; use this file only to override it locally.
# -----------------------------------------------------------------------------
LLM_PROVIDER=mock

# -----------------------------------------------------------------------------
# Zhipu GLM (recommended, has a free tier)
# Sign up: https://open.bigmodel.cn
# Free models: glm-4-flash / glm-4-flashx / glm-4.7-flash
# Flagship models: glm-5 / glm-4-plus / glm-4.7
# -----------------------------------------------------------------------------
GLM_API_KEY=your-glm-api-key-here
GLM_MODEL=glm-4-flash
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# -----------------------------------------------------------------------------
# Anthropic Claude
# Sign up: https://console.anthropic.com
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-haiku-4-5-20251001   # fast and low-cost; switch to claude-sonnet-4-6 for stronger results
CLAUDE_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# OpenAI
# Sign up: https://platform.openai.com
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# -----------------------------------------------------------------------------
# Ollama (local models, no API key needed)
# Install: https://ollama.ai
# Pull a model, e.g.: ollama pull llama3.2
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# -----------------------------------------------------------------------------
# Service configuration
# -----------------------------------------------------------------------------
AGENT_PORT=8001
LOG_LEVEL=INFO
MAX_CONTEXT_BLOCKS=5
STREAM_RESPONSE=true
