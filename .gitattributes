# Ensure Unix LF line endings for all text files checked out on any OS.
* text=auto eol=lf

# Explicitly enforce LF for shell scripts and source files.
*.sh    text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.cc    text eol=lf
*.c     text eol=lf
*.py    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binaries — no line-ending translation.
*.png   binary
*.jpg   binary
*.svg   binary
*.onnx  binary
*.onnx_data binary
*.pack  binary
*.idx   binary
